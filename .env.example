# =============================================================================
# HookForge — Environment Configuration (Example)
# Copy this file to .env and adjust values for local development.
# Never commit .env or real secrets.
# =============================================================================

# Application
APP_NAME=HookForge
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
# Dedicated pepper for API-key HMAC hashes (falls back to SECRET_KEY if empty)
API_KEY_PEPPER=
# Optional Fernet key (url-safe base64) for encrypting endpoint signing secrets at rest.
# In production, if empty, a key is derived from SECRET_KEY. Prefer an explicit key.
ENDPOINT_SECRET_ENCRYPTION_KEY=
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# API
API_V1_PREFIX=/api/v1

# CORS — comma-separated origins (no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trusted hosts (TrustedHostMiddleware in production only)
TRUSTED_HOSTS=localhost,127.0.0.1

# PostgreSQL (async SQLAlchemy / asyncpg)
# Local Windows: use dedicated role hookforge_app and database hookforge
# Docker Compose (backend service): postgresql+asyncpg://hookforge:hookforge@postgres:5432/hookforge
DATABASE_URL=postgresql+asyncpg://hookforge_app:CHANGE_ME@localhost:5432/hookforge

# Optional dedicated test database (pytest). Defaults to hookforge_test with same credentials.
# TEST_DATABASE_URL=postgresql+asyncpg://hookforge_app:CHANGE_ME@localhost:5432/hookforge_test

# Redis
# Local (host): redis://localhost:6379/0
# Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Frontend (Vite) — exposed to the browser at build/dev time
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ENV=development

# Database credentials used by docker-compose postgres service
POSTGRES_USER=hookforge
POSTGRES_PASSWORD=hookforge
POSTGRES_DB=hookforge

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60

# Auth / registration — must be false in production
ALLOW_PUBLIC_REGISTRATION=true

# Redis — required for live Celery enqueue.
# Development may set false (deliveries stay PENDING until recovery/worker can enqueue).
# Production MUST set true (fail-closed).
REDIS_REQUIRED=false

# Request limits
MAX_REQUEST_BODY_BYTES=1048576

# Delivery engine
DELIVERY_HTTP_TIMEOUT_SECONDS=10
DELIVERY_MAX_ATTEMPTS=6
DELIVERY_RETRY_BASE_DELAY_SECONDS=5
DELIVERY_RETRY_MAX_DELAY_SECONDS=3600
DELIVERY_RETRY_MULTIPLIER=2
DELIVERY_STALE_PROCESSING_SECONDS=300
DELIVERY_RECOVERY_BATCH_SIZE=100
DELIVERY_RECOVERY_INTERVAL_SECONDS=30
DELIVERY_MAX_PAYLOAD_BYTES=262144
# Must both be false in production
DELIVERY_ALLOW_HTTP_LOCALHOST=true
DELIVERY_SSRF_ALLOW_DEV_HTTP=true
